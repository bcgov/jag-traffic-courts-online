vars {
  tco.base_url: https://{{wsgw_host}}/tco/ords/{{db_name}}/tcoords
  occam.base_url: https://{{wsgw_host}}/occam/ords/{{db_name}}/occamords
  wsgw_host: wsgw.dev.jag.gov.bc.ca
  db_name: devj
  staff-api.host: http://localhost:8090/
  citizen-api.host: http://localhost:8080/
  staff-api.proxybypass: http://localhost:8090/
}
vars:secret [
  tco.username,
  tco.password,
  occam.username,
  occam.password,
  local.bearer_token
]
