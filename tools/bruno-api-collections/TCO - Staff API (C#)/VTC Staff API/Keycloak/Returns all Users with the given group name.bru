meta {
  name: Returns all Users with the given group name.
  type: http
  seq: 1
  tags: [
    Keycloak
  ]
}

get {
  url: {{baseUrl}}/api/keycloak/:groupName/users
  body: none
  auth: inherit
}

params:path {
  groupName: 
}

