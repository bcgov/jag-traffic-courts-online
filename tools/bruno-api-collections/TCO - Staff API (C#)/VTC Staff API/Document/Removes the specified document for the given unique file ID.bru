    url: {{baseUrl}}/api/document
    method: DELETE
    mode: none
    params:query: {
      ~fileId: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

