meta {
  name: Removes the specified document for the given unique file ID.
  type: http
  seq: 4
  tags: [
    Document
  ]
}

delete {
  url: {{baseUrl}}/api/document
  body: none
  auth: inherit
}

params:query {
  ~fileId: 
}

example {
  name: 200 Response
  description: The document is successfully removed.
  
