example {
  name: 500 Response
  description: There was a server error that prevented the file upload from completing successfully.
  
  request: {
    url: {{baseUrl}}/api/document
    method: POST
    mode: multipartForm
    headers: {
      ~disputeId: 
      noticeOfDisputeId: 
      documentType: 
    }
  
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    status: {
      code: 500
      text: Internal Server Error
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
