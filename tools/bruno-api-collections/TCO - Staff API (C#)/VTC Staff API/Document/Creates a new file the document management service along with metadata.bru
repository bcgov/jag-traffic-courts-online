example {
  name: 400 Response
  description: The request was not well formed. The file and ticket number are required
  
  request: {
    url: {{baseUrl}}/api/document
    method: POST
    mode: multipartForm
    headers: {
      ~disputeId: 
      noticeOfDisputeId: 
      documentType: 
    }
  
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "detail": "",
          "instance": ""
        }
      '''
    }
  }
}

