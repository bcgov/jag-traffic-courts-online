meta {
  name: Creates a new file the document management service along with metadata.
  type: http
  seq: 1
  tags: [
    Document
  ]
}

post {
  url: {{baseUrl}}/api/document
  body: multipartForm
  auth: inherit
}

headers {
  noticeOfDisputeId: 
  documentType: 
  ~disputeId: 
}

body:multipart-form {
  file: @file()
}

example {
  name: 200 Response
  description: The document is successfully uploaded and saved.
  
  request: {
    url: {{baseUrl}}/api/document
    method: POST
    mode: multipartForm
    headers: {
      ~disputeId: 
      noticeOfDisputeId: 
      documentType: 
    }
  
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "fileId": "",
          "fileName": "",
          "noticeOfDisputeGuid": "",
          "documentSource": "Citizen",
          "documentType": "",
          "documentStatus": "Filed",
          "virusScanStatus": "",
          "staffReviewStatus": "",
          "ticketNumber": "",
          "disputeId": 0,
          "pendingFileStream": "",
          "deleteRequested": false
        }
      '''
    }
  }
}

