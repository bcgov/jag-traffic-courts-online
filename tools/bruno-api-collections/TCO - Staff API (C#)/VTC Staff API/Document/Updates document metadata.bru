meta {
  name: Updates document metadata.
  type: http
  seq: 3
  tags: [
    Document
  ]
}

put {
  url: {{baseUrl}}/api/document
  body: none
  auth: inherit
}

params:query {
  fileId: 
}

headers {
  documentType: 
  documentStatus: Filed
  ~documentStatus: Pending
  ~documentStatus: Resolved
}

example {
  name: 200 Response
  description: The metadata has been updated.
  
  request: {
    url: {{baseUrl}}/api/document
    method: PUT
    mode: none
    params:query: {
      fileId: 
    }
  
    headers: {
      documentType: 
      documentStatus: Filed
      ~documentStatus: Pending
      ~documentStatus: Resolved
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: The request was not well formed.
  
  request: {
    url: {{baseUrl}}/api/document
    method: PUT
    mode: none
    params:query: {
      fileId: 
    }
  
    headers: {
      documentType: 
      documentStatus: Filed
      ~documentStatus: Pending
      ~documentStatus: Resolved
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "detail": "",
          "instance": ""
        }
      '''
    }
  }
}

