meta {
  name: Downloads a document for the given unique file ID if the virus scan staus is clean.
  type: http
  seq: 2
  tags: [
    Document
  ]
}

get {
  url: {{baseUrl}}/api/document
  body: none
  auth: inherit
}

params:query {
  ~fileId: 
}

example {
  name: 200 Response
  description: The document is successfully downloaded.
  
  request: {
    url: {{baseUrl}}/api/document
    method: GET
    mode: none
    params:query: {
      ~fileId: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

