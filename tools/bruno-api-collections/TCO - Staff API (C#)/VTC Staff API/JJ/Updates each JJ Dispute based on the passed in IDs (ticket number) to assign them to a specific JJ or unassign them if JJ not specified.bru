meta {
  name: Updates each JJ Dispute based on the passed in IDs (ticket number) to assign them to a specific JJ or unassign them if JJ not specified.
  type: http
  seq: 7
  tags: [
    JJ
  ]
}

put {
  url: {{baseUrl}}/api/jj/assign
  body: none
  auth: inherit
}

params:query {
  ticketNumbers: []
  ~username: 
}

example {
  name: 200 Response
  description: JJ Disputes are assigned/unassigned to/from a JJ successfully. The JJ Disputes are updated.
  
  request: {
    url: {{baseUrl}}/api/jj/assign
    method: PUT
    mode: none
    params:query: {
      ticketNumbers: []
      ~username: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

