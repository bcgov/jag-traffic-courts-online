meta {
  name: Updates court appearance record as well as the status of a particular JJDispute record to REQUIRE_COURT_HEARING, hearing type to COURT_APPEARANCE.
  type: http
  seq: 14
  tags: [
    JJ
  ]
}

put {
  url: {{baseUrl}}/api/jj/:ticketNumber/updatecourtappearance/requirecourthearing
  body: none
  auth: inherit
}

params:path {
  ticketNumber: 
}

headers {
  ~X-Timezone: 
}

example {
  name: 200 Response
  description: The court appearance and JJDispute status are updated.
  
  request: {
    url: {{baseUrl}}/api/jj/:ticketNumber/updatecourtappearance/requirecourthearing
    method: PUT
    mode: none
    params:path: {
      ticketNumber: 
    }
  
    headers: {
      ~X-Timezone: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

