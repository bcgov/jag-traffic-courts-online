meta {
  name: Updates the status of a particular JJDispute record to REVIEW when JJ wants to recall and open an ACCEPTED, CONFIRMED or CONCLUDED dispute.
  type: http
  seq: 8
  tags: [
    JJ
  ]
}

put {
  url: {{baseUrl}}/api/jj/:ticketNumber/recall
  body: none
  auth: inherit
}

params:query {
  ~checkVTC: 
}

params:path {
  ticketNumber: 
}

headers {
  ~X-Timezone: 
}

