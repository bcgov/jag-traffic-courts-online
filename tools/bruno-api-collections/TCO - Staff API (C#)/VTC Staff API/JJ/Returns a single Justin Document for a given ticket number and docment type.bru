meta {
  name: Returns a single Justin Document for a given ticket number and docment type.
  type: http
  seq: 4
  tags: [
    JJ
  ]
}

get {
  url: {{baseUrl}}/api/jj/ticketimage/:ticketNumber/:documentType
  body: none
  auth: inherit
}

params:path {
  ticketNumber: 
  documentType: UNKNOWN
  documentType: NOTICE_OF_DISPUTE
  documentType: TICKET_IMAGE
}

example {
  name: 200 Response
  description: The document was found.
  
  request: {
    url: {{baseUrl}}/api/jj/ticketimage/:ticketNumber/:documentType
    method: GET
    mode: none
    params:path: {
      ticketNumber: 
      documentType: UNKNOWN
      ~documentType: NOTICE_OF_DISPUTE
      ~documentType: TICKET_IMAGE
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "reportType": "UNKNOWN",
          "reportFormat": "",
          "partId": "",
          "participantName": "",
          "index": "",
          "fileData": "",
          "additionalProperties": {}
        }
      '''
    }
  }
}

