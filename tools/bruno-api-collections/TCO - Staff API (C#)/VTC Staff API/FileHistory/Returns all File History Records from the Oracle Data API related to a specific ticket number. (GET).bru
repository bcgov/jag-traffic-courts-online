meta {
  name: Returns all File History Records from the Oracle Data API related to a specific ticket number. (GET)
  type: http
  seq: 1
  tags: [
    FileHistory
  ]
}

get {
  url: {{baseUrl}}/api/filehistory/filehistory
  body: none
  auth: inherit
}

params:query {
  ~ticketNumber: 
}

headers {
  ~X-Timezone: 
}

example {
  name: 200 Response
  description: The File history records were found.
  
  request: {
    url: {{baseUrl}}/api/filehistory/filehistory
    method: GET
    mode: none
    params:query: {
      ~ticketNumber: 
    }
  
    headers: {
      ~X-Timezone: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "createdBy": "",
            "createdTs": "",
            "modifiedBy": "",
            "modifiedTs": "",
            "fileHistoryId": 0,
            "disputeId": 0,
            "auditLogEntryType": "UNKNOWN",
            "description": "",
            "comment": "",
            "actionByApplicationUser": "",
            "additionalProperties": {}
          }
        ]
      '''
    }
  }
}

