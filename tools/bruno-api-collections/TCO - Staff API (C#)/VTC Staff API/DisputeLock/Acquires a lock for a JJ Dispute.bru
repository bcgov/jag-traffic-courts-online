meta {
  name: Acquires a lock for a JJ Dispute.
  type: http
  seq: 1
  tags: [
    DisputeLock
  ]
}

get {
  url: {{baseUrl}}/api/disputelock
  body: none
  auth: inherit
}

params:query {
  ~ticketNumber: 
  ~username: 
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/disputelock
    method: GET
    mode: none
    params:query: {
      ~ticketNumber: 
      ~username: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "lockId": "",
          "ticketNumber": "",
          "username": "",
          "expiryTimeUtc": "",
          "createdAtUtc": ""
        }
      '''
    }
  }
}

