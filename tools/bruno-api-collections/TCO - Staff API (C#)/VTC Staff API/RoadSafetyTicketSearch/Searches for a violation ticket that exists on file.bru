meta {
  name: Searches for a violation ticket that exists on file.
  type: http
  seq: 1
  tags: [
    RoadSafetyTicketSearch
  ]
}

get {
  url: {{baseUrl}}/api/roadsafetyticketsearch
  body: none
  auth: inherit
}

params:query {
  ticketNumber: 
  issuedTime: 
}

example {
  name: 200 Response
  description: The violation ticket was found.
  
  request: {
    url: {{baseUrl}}/api/roadsafetyticketsearch
    method: GET
    mode: none
    params:query: {
      ticketNumber: 
      issuedTime: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "number": "",
          "issued": "",
          "surname": "",
          "firstGivenName": "",
          "secondGivenName": "",
          "counts": [
            {
              "number": 0,
              "ticketedAmount": 0,
              "amountDue": 0,
              "discountAmount": 0,
              "isAct": false,
              "isRegulation": false,
              "act": "",
              "section": "",
              "subsection": "",
              "paragraph": "",
              "subparagraph": "",
              "description": "",
              "formNumber": ""
            }
          ]
        }
      '''
    }
  }
}

