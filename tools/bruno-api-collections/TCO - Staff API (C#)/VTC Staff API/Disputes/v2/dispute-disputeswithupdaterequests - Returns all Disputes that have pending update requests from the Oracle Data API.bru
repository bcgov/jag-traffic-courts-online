meta {
  name: dispute/disputeswithupdaterequests - Returns all Disputes that have pending update requests from the Oracle Data API
  type: http
  seq: 13
  tags: [
    Dispute
  ]
}

get {
  url: {{baseUrl}}/api/v2/occam/dispute/disputeswithupdaterequests?ticket=AX&status=NEW&requestStatus=ACCEPTED&requestStatus=PENDING&requestStatus=REJECTED&sortBy=updateRequest_OldestDate&direction=desc&pageNumber=1&pageSize=25
  body: none
  auth: inherit
}

params:query {
  ticket: AX
  status: NEW
  requestStatus: ACCEPTED
  requestStatus: PENDING
  requestStatus: REJECTED
  sortBy: updateRequest_OldestDate
  direction: desc
  pageNumber: 1
  pageSize: 25
}

headers {
  ~X-Timezone: 
}

example {
  name: 200 Response
  description: The Disputes were found.
  
  request: {
    url: {{baseUrl}}/api/dispute/disputeswithupdaterequests
    method: GET
    mode: none
    headers: {
      ~X-Timezone: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
