meta {
  name: Updates the status of a particular Dispute record to CANCELLED.
  type: http
  seq: 8
  tags: [
    Dispute
  ]
}

put {
  url: {{baseUrl}}/api/dispute/:disputeId/cancel
  body: multipartForm
  auth: inherit
}

params:path {
  disputeId: 
}

body:multipart-form {
  cancelledReason: 
}

