meta {
  name: Disputes/Count - Returns the count of disputes with the given status.
  type: http
  seq: 1
  tags: [
    Dispute
  ]
}

get {
  url: {{baseUrl}}/api/dispute/disputes/count
  body: none
  auth: inherit
}

params:query {
  ~status: UNKNOWN
  ~status: NEW
  ~status: VALIDATED
  ~status: PROCESSING
  ~status: REJECTED
  ~status: CANCELLED
  ~status: CONCLUDED
}

example {
  name: 200 Response
  description: The Disputes were found.
  
  request: {
    url: {{baseUrl}}/api/dispute/disputes/count
    method: GET
    mode: none
    params:query: {
      ~status: UNKNOWN
      ~status: NEW
      ~status: VALIDATED
      ~status: PROCESSING
      ~status: REJECTED
      ~status: CANCELLED
      ~status: CONCLUDED
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "status": "UNKNOWN",
          "count": 0
        }
      '''
    }
  }
}

