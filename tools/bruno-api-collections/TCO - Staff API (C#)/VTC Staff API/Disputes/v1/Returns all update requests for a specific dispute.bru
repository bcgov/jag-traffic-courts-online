meta {
  name: Returns all update requests for a specific dispute
  type: http
  seq: 1
  tags: [
    Dispute
  ]
}

get {
  url: {{baseUrl}}/api/dispute/:disputeId/disputeupdaterequests
  body: none
  auth: inherit
}

