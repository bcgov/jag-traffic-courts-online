meta {
  name: Returns all Disputes that have pending update requests from the Oracle Data API (GET)
  type: http
  seq: 18
  tags: [
    Dispute
  ]
}

get {
  url: {{baseUrl}}/api/v2/occam/dispute/disputeswithupdaterequests
  body: none
  auth: inherit
}

params:query {
  ~excludeStatus: UNKNOWN
  ~excludeStatus: NEW
  ~excludeStatus: VALIDATED
  ~excludeStatus: PROCESSING
  ~excludeStatus: REJECTED
  ~excludeStatus: CANCELLED
  ~excludeStatus: CONCLUDED
  ~ticket: 
  ~surname: 
  ~status: UNKNOWN
  ~status: NEW
  ~status: VALIDATED
  ~status: PROCESSING
  ~status: REJECTED
  ~status: CANCELLED
  ~status: CONCLUDED
  ~from: 
  ~thru: 
  ~courthouseId: []
  ~requestStatus: UNKNOWN
  ~requestStatus: ACCEPTED
  ~requestStatus: PENDING
  ~requestStatus: REJECTED
  ~sortBy: []
  ~direction: asc
  ~direction: desc
  ~DefaultPageSize: 
  ~pageNumber: 
  ~pageSize: 
}

headers {
  ~X-Timezone: 
}

example {
  name: 200 Response
  description: The Disputes were found.
  
  request: {
    url: {{baseUrl}}/api/v2/occam/dispute/disputeswithupdaterequests
    method: GET
    mode: none
    params:query: {
      ~excludeStatus: UNKNOWN
      ~excludeStatus: NEW
      ~excludeStatus: VALIDATED
      ~excludeStatus: PROCESSING
      ~excludeStatus: REJECTED
