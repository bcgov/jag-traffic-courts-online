meta {
  name: Returns a list of Violation Ticket Statutes filtered by given section text (if provided). (GET)
  type: http
  seq: 2
  tags: [
    Lookup
  ]
}

get {
  url: {{baseUrl}}/api/lookup/statutes/v2
  body: none
  auth: inherit
}

params:query {
  ~section: 
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/lookup/statutes/v2
    method: GET
    mode: none
    params:query: {
      ~section: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": "",
            "actCode": "",
            "sectionText": "",
            "subsectionText": "",
            "paragraphText": "",
            "subparagraphText": "",
            "code": "",
            "shortDescriptionText": "",
            "descriptionText": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Request lacks valid authentication credentials.
  
  request: {
    url: {{baseUrl}}/api/lookup/statutes/v2
    method: GET
    mode: none
    params:query: {
      ~section: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "detail": "",
          "instance": ""
        }
      '''
    }
  }
}
