meta {
  name: Returns a list of countries.
  type: http
  seq: 9
  tags: [
    Lookup
  ]
}

get {
  url: {{baseUrl}}/api/lookup/country
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/lookup/country
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "ctryId": "",
            "ctryLongNm": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Request lacks valid authentication credentials.
  
  request: {
    url: {{baseUrl}}/api/lookup/country
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "",
          "title": "",
          "status": 0,
          "detail": "",
          "instance": ""
        }
      '''
    }
  }
}
