{
  "name": "staff-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "debug": "yarn start --configuration debug --port 4200",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build-dev": "ng build --source-map=false",
    "build-prod": "ng build --configuration production --source-map=false",
    "api:clean": "npx del-cli \"src/app/api/**\" \"!src/app/api/templates\"",
    "api:download": "npx download -o src/app/api http://localhost:5090/swagger/v1/swagger.json",
    "api:regenerate": "yarn run api:clean && yarn run api:download && yarn run api:generate",
    "api:regenerate:docker": "yarn run api:clean && yarn run api:download:docker && yarn run api:generate",
    "api:download:docker": "npx download -o src/app/api http://staff-api:8080/swagger/v1/swagger.json",
    "api:generate": "npx openapi-generator-cli generate -i src/app/api/swagger.json -g typescript-angular -t src/app/api/templates --additional-properties=modelFileSuffix=.model -o src/app/api",
    "api:r": "yarn run api:regenerate",
    "test": "ng test --browsers=ChromeHeadless --watch=false",
    "lint": "ng lint",
    "audit": "yarn-audit-fix --dry-run",
    "audit:fix": "yarn-audit-fix",
    "e2e": "ng e2e",
    "coverage": "ng test --browsers=ChromeHeadless --watch=false --code-coverage",
    "cypress": "./node_modules/.bin/cypress run --project e2e",
    "cypress-open": "./node_modules/.bin/cypress open --project e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.18",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.18",
    "@angular/compiler": "^19.2.18",
    "@angular/core": "^19.2.18",
    "@angular/forms": "^19.2.18",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.18",
    "@angular/platform-browser-dynamic": "^19.2.18",
    "@angular/router": "^19.2.18",
    "@bcgov/bc-sans": "^1.0.1",
    "@ngbracket/ngx-layout": "^18.0.0",
    "@ngrx/effects": "18.1.1",
    "@ngrx/operators": "^18.0.0",
    "@ngrx/store": "18.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.2",
    "dotenv": "^10.0.0",
    "keycloak-angular": "^16.1.0",
    "keycloak-js": "^22.0.4",
    "ng-busy": "^18.0.0",
    "ng-multiselect-dropdown": "^1.0.0",
    "ng2-currency-mask": "^13.0.3",
    "ngx-bootstrap": "^18.1.3",
    "ngx-mask": "^18.0.4",
    "ngx-progressbar": "^11.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "yargs": "^17.1.0",
    "yarn": "^1.22.11",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.18",
    "@ngrx/eslint-plugin": "^18.1.1",
    "@openapitools/openapi-generator-cli": "^2.28.3",
    "@types/jasmine": "~3.8.2",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "^16.4.13",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "cypress": "^8.2.0",
    "del-cli": "^7.0.0",
    "download-cli": "^1.1.1",
    "eslint": "^8.57.0",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.3.16",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-jasmine": "~4.0.1",
    "karma-jasmine-html-reporter": "^1.7.0",
    "protractor": "~7.0.0",
    "ts-node": "^10.9.1",
    "typescript": "5.8.3",
    "yarn-audit-fix": "^10.1.1"
  },
  "resolutions": {
    "postcss": "^8.1.0"
  }
}
